{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solure-maildesk",
  "account_id": "2b6c3404db3df23a12558f1852bc221c",
  "main": "src/server/dashboard.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "maildesk.soluredigitalworks.com", "custom_domain": true }],
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "solure-maildesk", "database_id": "1e984554-9e0c-455c-91be-aefaae407324", "migrations_dir": "migrations" }],
  "vars": {
    "OWNER_EMAIL": "elijah@soluredigitalworks.com",
    "DASHBOARD_ORIGIN": "https://maildesk.soluredigitalworks.com",
    "PIXEL_ORIGIN": "https://pixel.soluredigitalworks.com",
    "ACCESS_TEAM_DOMAIN": "throbbing-morning-dbde.cloudflareaccess.com",
    "ACCESS_AUD": "b49980e485cb0713b18722945eb6913009dca5a90133f0f80b04232fc285cf5e"
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false }
  // Add an EMAIL binding restricted to OWNER_EMAIL only after email onboarding.
  // Owner-only hostname Access covers every path; alternate Worker URLs stay disabled.
}
